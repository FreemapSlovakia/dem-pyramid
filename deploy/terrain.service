# systemd unit for the terrain service.
#
# Install:
#   cp terrain.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now terrain
#
# Replaces running it in tmux, which does not survive a reboot.

[Unit]
Description=Freemap terrain service (panorama, later viewshed and shadows)
After=network.target

[Service]
Type=simple
User=martin
WorkingDirectory=/fm/storage2/dem/build
ExecStart=/fm/storage2/dem/build/target/release/dem-tool serve \
    --root /fm/storage2/dem \
    --listen 127.0.0.1:3100 \
    --peaks /fm/storage2/dem/peaks.gpkg

# Loopback only; nginx is the only thing that should reach it.
Environment=GDAL_CACHEMAX=1024

# AVIF encoding writes an intermediate through /tmp. The service creates its
# own 0700 directory there, so this is belt and braces rather than the fix --
# but a private /tmp means a local user cannot even see the names.
PrivateTmp=yes

# A render saturates most of the box. Leave the tile servers and the API
# responsive: renders are a background nicety, serving maps is not.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# The largest legal viewshed measured 3.3 GB resident plus 0.8 GB of tmpfs --
# and `PrivateTmp` puts that tmpfs in RAM, so it is ~4 GB for one request. Most
# of it is the AVIF encoder rather than the renderer: the PNG is built whole in
# memory while the RGBA image is still live, and 96 megapixels then become
# 10-bit 4:4:4.
#
# Affordable on 62 GB, and renders are serialised. The cap is here because
# nothing else bounds it: a Rust allocation failure aborts rather than failing
# the request, so without this a pathological render competes with the tile
# servers and mariadb for the whole box. Better that this service dies alone
# and restarts than that it takes the site with it.
#
# High before Max, so the kernel reclaims and throttles before it kills.
MemoryHigh=8G
MemoryMax=12G

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
